{
  "name": "ampere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && tsx scripts/check-bundle.ts",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "cloud:identity": "tsx scripts/cloud-identity.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs arkiv README.md package.json tsconfig.json playwright.config.ts next.config.ts compose.yaml",
    "collect": "tsx --env-file-if-exists=.env.local scripts/collect.ts",
    "collect:watch": "tsx --env-file-if-exists=.env.local scripts/collect.ts --watch",
    "ethereum:send": "tsx --env-file-if-exists=.env.local scripts/send-frame.ts",
    "ethereum:send:faucet": "tsx --env-file-if-exists=.env.local scripts/send-frame.ts --faucet",
    "ethereum:inspect": "tsx --env-file-if-exists=.env.local scripts/inspect-frame.ts",
    "arkiv:seed": "tsx --env-file-if-exists=.env.local scripts/seed-arkiv.ts",
    "arkiv:benchmark": "tsx --env-file-if-exists=.env.local scripts/benchmark-arkiv.ts",
    "arkiv:benchmark:fixed": "tsx --env-file-if-exists=.env.local scripts/benchmark-arkiv.ts --fixed-block",
    "verify": "tsx scripts/verify.ts"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@forshtat/hegota-support": "^0.0.1",
    "@netlify/blobs": "^11.1.7",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
