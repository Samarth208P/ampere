ARKIV_RPC_URL=http://127.0.0.1:8545
ETHEREUM_RPC_URL=https://altmempoolgateway.forshtat.com/rpc
# Disk telemetry describes this filesystem on the collector host, not a Docker volume.
AMPERE_DISK_PATH=.
ARKIV_CONTAINER=ampere-arkiv-1

# Optional outbound publishing, configured ONLY on the collector machine.
# AMPERE_PUBLISH_URL=https://your-site.netlify.app/api/ingest
# AMPERE_INGEST_TOKEN=use-a-random-secret-of-at-least-32-characters
# Netlify runtime settings are listed in docs/NETLIFY.md. Do not set
# AMPERE_STORAGE=netlify on the machine that runs the local collector/dashboard.
